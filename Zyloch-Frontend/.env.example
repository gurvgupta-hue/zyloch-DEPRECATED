# =============================================================================
# Zyloch-Frontend  —  copy to .env  (gitignored)
#
# Every variable this service reads is listed here. Uncommented entries are
# REQUIRED; commented entries are optional and show the code default.
#
# In Docker these values are stored in Vault and fetched at container start by
# docker-entrypoint.sh. This file is what seeds Vault:
#   vault/scripts/03-import-secrets.sh
# Vault connection settings live separately — see .vault.env.example.
# =============================================================================

# --- Browser-facing (NEXT_PUBLIC_*) --------------------------------------------
# These are compiled into the client bundle at `next build` as __PLACEHOLDER__
# tokens and substituted at container start by docker-entrypoint.sh, so they can
# be changed without rebuilding. They MUST be addresses the user's browser can
# reach — never internal docker hostnames.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SCAN_API_URL=http://localhost:8009
NEXT_PUBLIC_GITHUB_APP_URL=https://github.com/apps/your-app-slug
# Public frontend URL used for the browser, SEO, metadataBase, sitemap, robots, and OpenGraph (defaults to https://zyloch.dev in production)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# --- Server-side only ----------------------------------------------------------
# Base URL the route guard in proxy.js uses to validate the session cookie against
# the backend's /auth/check-auth. NOT a rename of NEXT_PUBLIC_API_URL: that one is
# compiled into the browser bundle and must be an address the user's *browser* can
# reach, while this hop is made by the Next.js server inside the container and must
# be an address the *container* can reach. Falls back to NEXT_PUBLIC_API_URL, then
# http://localhost:5000.
#
# Set it. In Docker the two addresses genuinely differ, and the fallback does not
# work: NEXT_PUBLIC_API_URL is a host-published address (e.g. http://<host-ip>:5000)
# which is not routable from inside the frontend container, so every session check
# dies with "fetch failed". The guard fails open by design, so pages still load —
# it just silently stops validating anything, which is the worst of both worlds.
API_INTERNAL_URL=http://zyloch-backend:5000

# Used by the Next.js route app/api/spec-scanner/scan, which runs on the server
# and proxies to the spec generator. Internal docker address; never exposed to
# the browser. Defaults to http://localhost:8000, which is unreachable from
# inside the container — set it explicitly.
SPEC_GENERATOR_URL=http://openapispec-generator:8000

# --- Optional ------------------------------------------------------------------
# NOTE: unlike the four NEXT_PUBLIC_* vars above, these are NOT handled by the
# entrypoint's runtime substitution — they are baked in at build time, so
# changing them requires an image rebuild.

# GraphQL endpoint exposed by policy-scanner at /scan/graphql.
# The urql client in lib/graphql/client.js is currently unused.
# NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8009/scan/graphql

# AI-vs-human scanner backend. No such service exists in docker-compose today;
# leaving it empty disables the feature.
# NEXT_PUBLIC_AI_SERVICE_URL=

# Comma-separated extra origins allowed by Next.js in dev.
# NEXT_ALLOWED_DEV_ORIGINS=
