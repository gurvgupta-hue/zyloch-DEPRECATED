# =============================================================================
# Zyloch-GHAPP-Backend (policy-scanner)  —  copy to .env  (gitignored)
#
# Every variable this service reads is listed here. Uncommented entries are
# REQUIRED; commented entries are optional and show the code default.
#
# In Docker these values are stored in Vault and fetched at container start by
# docker-entrypoint.sh. This file is what seeds Vault:
#   vault/scripts/03-import-secrets.sh
# Vault connection settings live separately — see .vault.env.example.
#
# Precedence at runtime (highest first):
#   docker-compose `environment:`  >  Vault  >  this file
# =============================================================================

# --- Zyloch application database (OUR cluster) ---------------------------------
# MUST be the same cluster as Zyloch-Backend's MONGO_URI. The scanner reads
# zyloch_control.installation_index here to map a GitHub installation to its
# tenant, then writes scan results into that tenant's database.
# Pointing this at a different deployment causes:
#   "No tenant mapping for installation_id=..."
MONGODB_URL=mongodb://user:password@host:27017/admin?authSource=admin
DATABASE_NAME=policy_scanner

# Multi-tenant DB naming — must match Zyloch-Backend exactly. Both services have
# built-in defaults, but set them explicitly: Docker deployments read these from
# Vault, and Vault is only seeded from this file.
CONTROL_DATABASE_NAME=zyloch_control
TENANT_DB_PREFIX=zyloch_tenant_

# --- External intelligence database (THIRD-PARTY, not ours) --------------------
# Separate, externally managed MongoDB owned by a third party. We only READ
# vulnerability/SBOM intelligence from it — it is NOT part of the Zyloch cluster
# above, has its own credentials and lifecycle, and must not be pointed at
# MONGODB_URL. Required for SBOM enrichment.
intel_repo_url=mongodb://user:password@intel-host:27017/IntelDB?authSource=admin
SBOM_DATABASE_NAME=IntelDB

# Fallback URI used only if intel_repo_url is unset (intel_repo_url wins).
# SBOM_MONGODB_URL=
# SBOM_MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# --- CVE intelligence database (THIRD-PARTY, not ours) -------------------------
# Externally managed MongoDB holding CVE records, read by
# scanner_core/helpers/cve_finder.py for OSS risk enrichment. Like intel_repo_url
# above it is NOT part of the Zyloch cluster and must not point at MONGODB_URL.
# If cve_repo_url is unset, CVE enrichment is disabled and lookups raise.
cve_repo_url=cve_mongodb_url
CVE_DATABASE_NAME=cve_mongodb_database

# --- GitHub App ----------------------------------------------------------------
# Same GitHub App as Zyloch-Backend, but note the different variable name for
# the key there (GITHUB_PRIVATE_KEY). Escape newlines as \n.
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# --- Service-to-service auth ---------------------------------------------------
# Must be IDENTICAL to GHAPP_S2S_API_KEY in Zyloch-Backend/.env. Incoming scan
# API calls are rejected with 401 unless the X-Zyloch-Service-Key header matches.
GHAPP_S2S_API_KEY=change-me-to-a-long-random-secret

# --- OpenAPI spec generator ----------------------------------------------------
# Internal docker address of the openapispec-generator service.
SPEC_GENERATOR_URL=http://openapispec-generator:8000
# SPEC_GENERATOR_ENDPOINT=/v2/generate-and-validate
# SPEC_GENERATOR_TIMEOUT=600              # seconds

# --- Service exposure ----------------------------------------------------------
# Comma-separated browser origins allowed to call this service cross-origin.
# Empty (the default) means no browser origin is allowed, which is correct in
# normal operation: the product frontend reaches this service through the backend
# BFF, never directly. Only set it if something must call GHAPP from a browser.
# Credentials are always off, so `*` is never echoed back to an arbitrary site.
# GHAPP_CORS_ORIGINS=

# Expose /docs, /redoc and /openapi.json without the internal service credential.
# Protected by default — the schema maps every internal endpoint. Local dev only;
# never enable outside a developer machine.
# GHAPP_PUBLIC_DOCS=false

# --- Scanner behaviour ---------------------------------------------------------
# WRITE_ARTIFACTS=false                   # note: the /scan route defaults this to true
# WRITE_MD_REPORTS=false
# YARA_MAX_FILE_SIZE=10485760             # 10 MB
# YARA_SCAN_THREADS=4
# GITHUB_WORKSPACE=.                      # scan workspace root
# LOG_DIR=

# GCP-backed secret detection (only if that scanner is enabled)
# GCP_PROJECT_ID=
# GCP_CREDENTIALS_PATH=gcp-credentials.json

# Legacy: read by config.db.get_main_database(), which currently has no callers.
# MAIN_DATABASE_NAME=zyloch
