{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "test:report": "mkdir -p test-reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-reports/junit-Zyloch-Backend.xml tests/*.test.js",
    "catalog:export": "node scripts/export-capability-catalog.js",
    "catalog:check": "node scripts/export-capability-catalog.js --check",
    "test:contract": "node ../scripts/mt-test/contract-audit.js",
    "mt:seed": "node ../scripts/mt-test/seed-tenants.js",
    "mt:probe": "node ../scripts/mt-test/isolation-probe.js",
    "test:mt": "npm test && npm run test:contract"
  },
