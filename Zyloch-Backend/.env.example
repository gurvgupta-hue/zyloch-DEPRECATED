# =============================================================================
# Zyloch-Backend  —  copy to .env  (gitignored)
#
# Every variable this service reads is listed here. Uncommented entries are
# REQUIRED; commented entries are optional and show the code default.
#
# In Docker these values are stored in Vault and fetched at container start by
# docker-entrypoint.sh. This file is what seeds Vault:
#   vault/scripts/03-import-secrets.sh
# Vault connection settings live separately — see .vault.env.example.
#
# Precedence at runtime (highest first):
#   docker-compose `environment:`  >  Vault  >  this file
# =============================================================================

# --- Database -----------------------------------------------------------------
# Cluster hosting the control DB (zyloch_control) and every per-tenant DB.
# Zyloch-GHAPP-Backend's MONGODB_URL MUST point at this same cluster, or scans
# fail with "No tenant mapping for installation_id=...".
MONGO_URI=mongodb://user:password@host:27017/zyloch?authSource=admin

# --- OAuth App ("Login with GitHub") -------------------------------------------
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URI=http://localhost:5000/auth/github/callback

# Browser-facing frontend origin. Also the allowed CORS origin, and used to
# decide cookie Secure/SameSite flags.
FRONTEND_URL=http://localhost:3000

# --- GitHub App ----------------------------------------------------------------
# Same GitHub App as the GHAPP service, but note it uses a different variable
# name there (GITHUB_APP_PRIVATE_KEY). Escape newlines in the key as \n.
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY=your_github_app_private_key
GITHUB_WEBHOOK_SECRET=your_webhook_secret
# Max accepted webhook body. An "All repositories" install on an org with
# thousands of repos ships several MB of repository metadata; anything smaller
# than the payload is answered with 413 and GitHub marks the delivery failed.
# GitHub itself caps a delivery at 25MB.
# GITHUB_WEBHOOK_BODY_LIMIT=25mb

# --- Secrets -------------------------------------------------------------------
APP_JWT_SECRET=your_jwt_signing_secret
APP_ENCRYPTION_SECRET=your_encryption_secret

# --- Redis (BullMQ queues) -----------------------------------------------------
REDIS_URL=redis://:password@host:6379
# REDIS_TLS=false

# --- Service-to-service auth ---------------------------------------------------
# Must be IDENTICAL to GHAPP_S2S_API_KEY in Zyloch-GHAPP-Backend/.env.
# Sent as the X-Zyloch-Service-Key header; a mismatch makes every scan call 401.
GHAPP_S2S_API_KEY=change-me-to-a-long-random-secret

# --- Service topology ----------------------------------------------------------
# Internal address of the GHAPP/policy-scanner service, used server-to-server.
# Must NOT be a browser-facing URL — that is unreachable from inside the
# container and causes 30-120s timeouts on every scan call.
# Has a code default, but set it explicitly: Docker deployments read it from
# Vault, and Vault is only seeded from this file.
SCAN_API_URL=http://policy-scanner:8000

# Deprecated fallback used only when SCAN_API_URL is unset. Prefer SCAN_API_URL.
# NEXT_PUBLIC_SCAN_API_URL=

# --- Multi-tenant DB naming ----------------------------------------------------
# Must match Zyloch-GHAPP-Backend exactly — both services derive the control and
# per-tenant database names from these. Same reason as above: set explicitly so
# the values reach Vault rather than relying on each service's built-in default.
CONTROL_DATABASE_NAME=zyloch_control
TENANT_DB_PREFIX=zyloch_tenant_

# First GitHub login provisions a tenant DB: ~9 collections and ~25 index
# builds. Journal fsync on the dev Mongo host averages ~200ms, so each DDL
# costs seconds and the whole provision measures ~115s — well past the 45s
# driver default in db/connectionManager.js, which aborted login midway.
# Only DDL is slow here; ordinary reads/writes stay in single-digit ms.
#
#  This is a workaround for the host's storage, not a value worth carrying to prod —
# drop it back to the default once fsync latency is fixed.
MONGO_SOCKET_TIMEOUT_MS=300000

# --- Email (Resend) -------------------------------------------------------------
# Transactional email (e.g. "you've been added to this organization" on invite).
# Get a key at https://resend.com/api-keys; RESEND_FROM_EMAIL must be a verified
# sender/domain on that account. Left blank, email notifications are skipped —
# member invites still work, just without the email.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=notifications@yourdomain.com

# --- Optional ------------------------------------------------------------------
# PORT=5000
# NODE_ENV=development
# DEFAULT_LICENSE_PLAN_ID=basic
# MICROSOFT_TENANT=common                 # Microsoft OAuth tenant
# SECURITY_SIGNALS_DEBUG=false
# GITHUB_ORG_AUDIT_TOKEN=                 # org audit-log signals; falls back to the App token
# ENFORCE_GITHUB_MEMBERSHIP=false         # KAN-51: when true, hide installs the user is not a GitHub org member of

# Rate limit on the unauthenticated org-discovery lookup (GET /auth/resolve-org).
# Per-IP. Deliberately generous — a person typing their domain, or a shared
# office NAT, must never see a 429; the limit exists to blunt domain enumeration.
# DISCOVERY_RATE_WINDOW_MS=900000         # 15 minutes
# DISCOVERY_RATE_MAX=30                   # lookups per IP per window

# Mongo connection-pool tuning (single shared pool across all tenant DBs)
# MAX_TENANT_CONNECTIONS=50               # cached tenant DB handles (LRU)
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=0
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_MAX_IDLE_TIME_MS=60000
